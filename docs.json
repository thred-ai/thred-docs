{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Thred",
  "colors": {
    "primary": "#3AA4C1",
    "light": "#3AA4C1",
    "dark": "#3AA4C1"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "introduction",
          "quickstart",
          "guides/what-you-can-build"
        ]
      },
      {
        "group": "Search API",
        "pages": [
          "api-reference/create-search",
          "api-reference/get-search",
          "api-reference/search-results",
          "api-reference/cancel-search"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/webhooks"
        ]
      },
      {
        "group": "Account and utilities",
        "pages": [
          "api-reference/authentication",
          "api-reference/get-usage",
          "api-reference/health"
        ]
      }
    ]
  },
  "favicon": "/logo/thred.svg",
  "logo": {
    "light": "/logo/thred.svg",
    "dark": "/logo/thred.svg"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#1D1D1D"
    }
  },
  "description": "Build apps and AI assistants with information gathered over the phone.",
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://thred.ai"
      }
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "all"
    }
  },
  "fonts": {
    "family": "Instrument Sans"
  }
}
