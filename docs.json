{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Thred API",
  "colors": {
    "primary": "#3AA4C1",
    "light": "#3AA4C1",
    "dark": "#3AA4C1"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "introduction",
          "quickstart",
          "guides/what-you-can-build"
        ]
      },
      {
        "group": "Collect API",
        "pages": [
          "api-reference/create-collection",
          "api-reference/get-collection",
          "api-reference/list-collections",
          "api-reference/cancel-collection",
          "api-reference/get-recording"
        ]
      },
      {
        "group": "Account and utilities",
        "pages": [
          "api-reference/authentication",
          "api-reference/get-usage",
          "api-reference/health"
        ]
      }
    ]
  },
  "favicon": "/images/icon.ico",
  "logo": {
    "light": "/images/logo_full_dark.png",
    "dark": "/images/logo_full_light.png"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#1D1D1D"
    }
  },
  "description": "The data API for the phone. Collect structured answers from a known phone number.",
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://thred.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.thred.ai"
    }
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  },
  "fonts": {
    "family": "Instrument Sans"
  }
}
