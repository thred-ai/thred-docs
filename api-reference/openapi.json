{
  "openapi": "3.0.3",
  "info": {
    "title": "Thred API",
    "version": "2.0.0",
    "description": "Search for answers from businesses by phone. Supply a query and call budget; Thred discovers relevant businesses, generates questions, calls them, and returns paginated outcomes. API keys select workspace and environment."
  },
  "servers": [
    {
      "url": "https://api.thred.dev",
      "description": "Thred API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Verify the workspace and environment selected by your API key."
    },
    {
      "name": "Usage",
      "description": "Read daily operational usage."
    },
    {
      "name": "Health",
      "description": "Check public API availability."
    },
    {
      "name": "Search",
      "description": "Discover businesses and collect phone-verified answers."
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Health"
        ],
        "summary": "Check API health",
        "description": "Check whether the API service responds. No API key is needed.",
        "security": [],
        "responses": {
          "200": {
            "description": "API service is responding.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "operationId": "getIdentity",
        "tags": [
          "Authentication"
        ],
        "summary": "Check your API key",
        "description": "Check your key and see its workspace and environment.",
        "responses": {
          "200": {
            "description": "Authenticated key identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "operationId": "getUsage",
        "tags": [
          "Usage"
        ],
        "summary": "Get daily usage",
        "description": "Read daily search and call counters for 1\u201331 inclusive UTC days. Both dates default to today. Search metrics use the search creation date; call metrics use the call creation date. These counters are not a billing statement.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First UTC date, inclusive. Defaults to today.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "example": "2026-10-30"
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last UTC date, inclusive. Must be on or after from and no more than 30 days later. Defaults to today.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "example": "2026-10-30"
          }
        ],
        "responses": {
          "200": {
            "description": "Daily operational usage for the selected API environment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "operationId": "createSearch",
        "summary": "Create a search",
        "description": "Discover relevant businesses and call them to answer a query. Returns HTTP 202 immediately; poll progress and results while work runs. Reuse the same Idempotency-Key and identical request for retries; a changed request with the same key returns 409. Omitting the header creates a new search on each POST. Maximum 20 unfinished searches per workspace/environment.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[!-~]{1,200}$"
            },
            "description": "Optional retry key containing 1\u2013200 printable, non-space ASCII characters. Reuse it with the same request to avoid creating another search."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              },
              "examples": {
                "textAnswers": {
                  "summary": "Text answers",
                  "value": {
                    "query": "Which dentists in Toronto accept new patients and have appointments this week?",
                    "results": 2,
                    "timezone": "America/Toronto"
                  }
                },
                "customOutput": {
                  "summary": "Text answers with custom fields",
                  "value": {
                    "query": "Which dentists in Toronto accept new patients and have appointments this week?",
                    "results": 2,
                    "timezone": "America/Toronto",
                    "output": {
                      "accepting_new_patients": {
                        "type": "boolean",
                        "description": "Whether the practice accepts new patients."
                      },
                      "appointments_this_week": {
                        "type": "boolean",
                        "description": "Whether an appointment is available this week in the requested timezone."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Search accepted or existing idempotent search returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Search"
                },
                "example": {
                  "id": "search_6c479a30-cf06-4dba-8dc9-2d2893bbc64f",
                  "query": "Which dentists in Toronto accept new patients and have appointments this week?",
                  "status": "discovering",
                  "environment": "development",
                  "identity": {
                    "name": "AI assistant"
                  },
                  "call_reason": "public",
                  "requested_calls": 2,
                  "selected_businesses": 0,
                  "attempted_calls": 0,
                  "answered_calls": 0,
                  "published_results": 0,
                  "discovery_shortfall": null,
                  "created_at": "2026-11-12T15:00:00Z",
                  "deadline_at": "2026-11-12T15:30:00Z",
                  "finished_at": null,
                  "terminal": false,
                  "cancellation_requested": false,
                  "stop_reason": null,
                  "error": null
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated request identifier for correlating this response.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          }
        }
      }
    },
    "/search/{id}": {
      "get": {
        "tags": [
          "Search"
        ],
        "operationId": "getSearch",
        "summary": "Get search progress",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "search_..."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search progress.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Search"
                },
                "example": {
                  "id": "search_6c479a30-cf06-4dba-8dc9-2d2893bbc64f",
                  "query": "Which dentists in Toronto accept new patients and have appointments this week?",
                  "status": "running",
                  "environment": "development",
                  "identity": {
                    "name": "AI assistant"
                  },
                  "call_reason": "public",
                  "requested_calls": 2,
                  "selected_businesses": 2,
                  "attempted_calls": 1,
                  "answered_calls": 1,
                  "published_results": 1,
                  "discovery_shortfall": 0,
                  "created_at": "2026-11-12T15:00:00Z",
                  "deadline_at": "2026-11-12T15:30:00Z",
                  "finished_at": null,
                  "terminal": false,
                  "cancellation_requested": false,
                  "stop_reason": null,
                  "error": null
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated request identifier for correlating this response.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "description": "Read the current status and progress counters. Continue polling until terminal is true. Results are retrieved separately from GET /search/{id}/results."
      }
    },
    "/search/{id}/results": {
      "get": {
        "tags": [
          "Search"
        ],
        "operationId": "getSearchResults",
        "summary": "Get paginated results",
        "description": "Read saved outcomes in immutable publication order. GET never initiates calls. Continue polling next_cursor while terminal is false. Relevance rank is included separately.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "search_..."
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque next_cursor from a previous page of this search. Omit it to start at the first published outcome."
          }
        ],
        "responses": {
          "200": {
            "description": "Saved business outcomes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResultsPage"
                },
                "examples": {
                  "textAnswers": {
                    "summary": "Text answers and a canceled call",
                    "description": "Fictional outcomes: a confirmed negative answer and a business canceled before dialing. No custom output was requested.",
                    "value": {
                      "id": "search_6c479a30-cf06-4dba-8dc9-2d2893bbc64f",
                      "status": "canceled",
                      "results": [
                        {
                          "id": "result_example_1",
