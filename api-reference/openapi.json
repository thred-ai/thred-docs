{
  "openapi": "3.0.3",
  "info": {
    "title": "Thred API",
    "version": "1.0.0",
    "description": "Thred is the data API for the phone. Use Collect when you know who to ask: send a phone number and instructions, add context values in input, and name the answers you want and their types in output. Use the same base URL for Development and Production; your API key selects the environment."
  },
  "servers": [
    {
      "url": "https://api.thred.dev",
      "description": "Thred API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Verify the workspace and environment selected by your API key."
    },
    {
      "name": "Collect",
      "description": "Collect structured answers from a known phone number."
    },
    {
      "name": "Usage",
      "description": "Read daily operational usage."
    },
    {
      "name": "Health",
      "description": "Check public API availability."
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Health"
        ],
        "summary": "Check API health",
        "description": "Check whether the API service responds. No API key is needed.",
        "security": [],
        "responses": {
          "200": {
            "description": "API service is responding.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "operationId": "getIdentity",
        "tags": [
          "Authentication"
        ],
        "summary": "Check your API key",
        "description": "Check your key and see its workspace and environment.",
        "responses": {
          "200": {
            "description": "Authenticated key identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/collect": {
      "post": {
        "operationId": "createCollection",
        "tags": [
          "Collect"
        ],
        "summary": "Create a collection",
        "description": "Collect answers from a known phone number. Send instructions, optional context in input, and an output map of answer names to types. Use the returned ID to retrieve the result, or provide a webhook_id. Development and Production can both place real calls.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional key for retrying a request without creating another collection. Omit it to create a new collection on each POST. Reuse the same key only with the same request; a different request returns 409. Use 1\u2013200 printable, non-space ASCII characters.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[!-~]{1,200}$"
            },
            "example": "business-hours-001"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The destination, instructions, optional input context, and requested output fields.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCallRequest"
              },
              "example": {
                "to": "+14155550123",
                "instructions": "Ask whether the business is open on the date in input and what time it closes.",
                "input": {
                  "date": "today"
                },
                "output": {
                  "is_open": "boolean",
                  "closes_at": "string"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "New collection accepted, or an existing idempotent request returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedCall"
                },
                "example": {
                  "id": "call_123e4567-e89b-42d3-a456-426614174000",
                  "status": "queued"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "get": {
        "operationId": "listCollections",
        "tags": [
          "Collect"
        ],
        "summary": "List collections",
        "description": "List collections in your workspace and API environment, newest first. Pass next_cursor as cursor to get the next page.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum collections to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque next_cursor from a previous response. Omit for the first page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of collections.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/collect/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The collection ID returned when the request was accepted. IDs use the call_ prefix.",
          "schema": {
            "type": "string",
            "pattern": "^call_[a-z0-9-]+$"
          },
          "example": "call_123e4567-e89b-42d3-a456-426614174000"
        }
      ],
      "get": {
        "operationId": "getCollection",
        "tags": [
          "Collect"
        ],
        "summary": "Get a collection",
        "description": "Get the latest status and answers in output. Keep polling until status is completed, incomplete, failed, or canceled. output is null before results are available. Incomplete results include missing_fields; error is included only when present.",
        "responses": {
          "200": {
            "description": "The current collection and its published results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Call"
                },
                "example": {
                  "id": "call_123e4567-e89b-42d3-a456-426614174000",
                  "status": "completed",
                  "output": {
                    "is_open": true,
                    "closes_at": "5 PM"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/collect/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The collection ID returned when the request was accepted. IDs use the call_ prefix.",
          "schema": {
            "type": "string",
            "pattern": "^call_[a-z0-9-]+$"
          },
          "example": "call_123e4567-e89b-42d3-a456-426614174000"
        }
      ],
      "post": {
        "operationId": "cancelCollection",
        "tags": [
          "Collect"
        ],
        "summary": "Cancel a collection",
        "description": "Request cancellation of an open collection, then poll for its final status. No request body is needed. Repeated requests and requests for already closed collections return the current state.",
        "responses": {
          "202": {
            "description": "Cancellation recorded, or the current state of an already closed or cancel-requested collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cancellation"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/collect/{id}/recording": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The collection ID returned when the request was accepted. IDs use the call_ prefix.",
          "schema": {
            "type": "string",
            "pattern": "^call_[a-z0-9-]+$"
          },
          "example": "call_123e4567-e89b-42d3-a456-426614174000"
        }
      ],
      "get": {
        "operationId": "getRecording",
        "tags": [
          "Collect"
        ],
        "summary": "Get a recording link",
        "description": "Recording is currently disabled on the hosted API. When enabled and ready, this endpoint returns a private playback link valid for approximately 15 minutes.",
        "responses": {
          "200": {
            "description": "Temporary playback link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingLink"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/RecordingUnavailable"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "operationId": "getUsage",
        "tags": [
          "Usage"
        ],
        "summary": "Get daily usage",
        "description": "Read daily collection counts and elapsed job seconds for 1\u201331 inclusive UTC days. Both dates default to today. Usage is attributed to the collection\u2019s creation date and is not a billing statement.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First UTC date, inclusive. Defaults to today.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "example": "2026-10-30"
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last UTC date, inclusive. Must be on or after from and no more than 30 days later. Defaults to today.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "example": "2026-10-30"
          }
        ],
        "responses": {
          "200": {
            "description": "Daily operational usage for the selected API environment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Thred API key",
        "description": "Send Authorization: Bearer <THRED_API_KEY>. Development keys begin thr_dev_; Production keys begin thr_prod_. Each key is scoped to a workspace and environment. Keep secrets on your server."
      }
    },
    "schemas": {
      "Environment": {
        "type": "string",
        "enum": [
          "development",
          "production"
        ],
        "description": "The API key selects the workspace environment. Development and Production are isolated, but either can place real calls when enabled."
      },
      "CallStatus": {
        "type": "string",
        "enum": [
          "queued",
          "dialing",
          "in_progress",
          "processing",
          "awaiting_review",
          "completed",
          "incomplete",
          "failed",
          "canceled"
        ],
        "description": "Final: completed, incomplete, failed, canceled. Continue polling for all other statuses."
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error explanation."
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "thred-data-backend"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "environment": {
            "type": "string",
            "example": "production",
            "description": "API deployment environment. This is not the environment selected by an API key."
          }
        },
        "required": [
          "service",
          "status",
          "environment"
        ]
      },
      "Identity": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "description": "Workspace associated with the API key."
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "key_id": {
            "type": "string",
            "description": "Identifier of the authenticated key; never the key secret."
          }
        },
        "required": [
          "workspace_id",
          "environment",
          "key_id"
        ]
      },
      "Navigation": {
        "type": "object",
        "properties": {
          "contact_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Person to ask for."
          },
          "department": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Department to reach."
          },
          "extension": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "pattern": "^[0-9]+$",
            "description": "Extension hint, used when an appropriate extension-entry prompt is heard."
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8}){0,3}$",
            "example": "en",
            "description": "Language tag, such as en or fr-CA."
          }
        },
        "description": "Optional routing hints. IVR navigation is automatic. Custom routes, actions, and navigation policy overrides are not accepted.",
        "additionalProperties": false
      },
      "ScreenerMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Approved spoken copy; must contain non-whitespace text."
          },
          "type": {
            "type": "string",
            "enum": [
              "intro",
              "detail"
            ],
            "description": "The first message must be intro; all later messages must be detail."
          }
        },
        "required": [
          "message",
          "type"
        ],
        "additionalProperties": false
      },
      "CreateCallRequest": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "example": "+14155550123",
            "description": "Destination phone number in E.164 format."
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "description": "What you want to find out. Thred manages conversation, navigation, and assistance. Must contain non-whitespace text."
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "default": {},
            "description": "Known context values for the call, such as a date, product name, or reference number. Must be a JSON object; optional and defaults to an empty object. Up to 16,000 bytes of JSON. Maximum depth: 32; maximum values: 8,192.",
            "example": {
              "date": "today"
            }
          },
          "output": {
            "$ref": "#/components/schemas/OutputFields"
          },
          "max_duration_seconds": {
            "type": "integer",
            "default": 300,
            "minimum": 30,
            "maximum": 1800,
            "description": "Maximum job duration. Your workspace and environment may have a lower limit."
          },
          "caller_number_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Enabled caller number ID belonging to the same workspace and environment. Omit to use the environment default."
          },
          "webhook_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Enabled webhook endpoint ID from your dashboard, in the same workspace and environment. Omit to poll for results."
          },
          "navigation": {
            "$ref": "#/components/schemas/Navigation"
          },
          "screener_sequence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/ScreenerMessage"
            },
            "description": "An intro followed by optional detail messages for screeners. If omitted, Thred prepares a sequence from the task and input before dialing."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "default": {},
            "description": "Your tracking fields, up to 4,000 bytes of JSON. Maximum depth: 32; maximum values: 8,192."
          },
          "record": {
            "type": "boolean",
            "default": false,
            "description": "Recording is currently disabled. Leave false or omit; true returns 503."
          }
        },
        "required": [
          "to",
          "instructions",
          "output"
        ],
        "description": "Send UTF-8 JSON, up to 64 KiB. Unknown fields are rejected.",
        "additionalProperties": false
      },
      "AcceptedCall": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "call_123e4567-e89b-42d3-a456-426614174000",
            "description": "The collection ID, using the call_ prefix. Use it to retrieve or cancel the collection."
          },
          "status": {
            "$ref": "#/components/schemas/CallStatus"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      },
      "Call": {
        "type": "object",
        "description": "The collection status and published answers. Returned by retrieve, list, and cancel endpoints and inside webhook event data.",
        "properties": {
          "id": {
            "type": "string",
            "example": "call_123e4567-e89b-42d3-a456-426614174000",
            "description": "The collection ID, using the call_ prefix."
          },
          "status": {
            "$ref": "#/components/schemas/CallStatus"
          },
          "output": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Answers in the requested shape. Contains available answers for an incomplete collection, or null before results are available."
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Included only when status is incomplete. Explains which answers are missing."
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "id",
          "status",
          "output"
        ]
      },
      "CallList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Call"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true,
            "description": "Opaque cursor for the next page. Null means there are no more results."
          }
        },
        "required": [
          "data",
          "next_cursor"
        ]
      },
      "RecordingLink": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Temporary private playback URL. Treat the URL as a secret."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC expiry time, approximately 15 minutes after issuance."
          }
        },
        "required": [
          "url",
          "expires_at"
        ]
      },
      "DailyUsage": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "requested": {
            "type": "integer",
            "minimum": 0,
            "description": "Accepted collections, counted once. Idempotent replays do not increment this count."
          },
          "completed": {
            "type": "integer",
            "minimum": 0
          },
          "incomplete": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "canceled": {
            "type": "integer",
            "minimum": 0
          },
          "human_assisted": {
            "type": "integer",
            "minimum": 0,
            "description": "Finalized collections that had live human assistance."
          },
          "elapsed_job_seconds": {
            "type": "number",
            "minimum": 0,
            "description": "Operational elapsed duration recorded on physical call closure."
          }
        },
        "required": [
          "day",
          "requested",
          "completed",
          "incomplete",
          "failed",
          "canceled",
          "human_assisted",
          "elapsed_job_seconds"
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "timezone": {
            "type": "string",
            "enum": [
              "UTC"
            ]
          },
          "attribution": {
            "type": "string",
            "enum": [
              "call_created_date"
            ]
          },
          "billing_status": {
            "type": "string",
            "enum": [
              "unreconciled"
            ]
          },
          "billed_seconds": {
            "type": "number",
            "nullable": true,
            "enum": [
              null
            ],
            "description": "Always null; these counters are not billing reconciliation."
          },
          "data": {
            "type": "array",
            "minItems": 1,
            "maxItems": 31,
            "items": {
              "$ref": "#/components/schemas/DailyUsage"
            }
          }
        },
        "required": [
          "from",
          "to",
          "environment",
          "timezone",
          "attribution",
          "billing_status",
          "billed_seconds",
          "data"
        ]
      },
      "OutputFields": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        },
        "description": "Map each answer name to its type. All declared answers are expected. Names must contain 1\u2013120 characters and cannot be __proto__, prototype, or constructor. Use instructions for details about what to ask.",
        "example": {
          "is_open": "boolean",
          "closes_at": "string"
        },
        "maxProperties": 127
      },
