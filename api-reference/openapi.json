    "/search/{id}/cancel": {
      "post": {
        "tags": [
          "Search"
        ],
        "operationId": "cancelSearch",
        "summary": "Cancel a search",
        "description": "Idempotently stop queued work and request termination of active calls. Already published outcomes remain available. Cancellation settles after child calls are reconciled.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "search_..."
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Cancellation requested or terminal search returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Search"
                },
                "example": {
                  "id": "search_6c479a30-cf06-4dba-8dc9-2d2893bbc64f",
                  "query": "Which dentists in Toronto accept new patients and have appointments this week?",
                  "status": "canceling",
                  "environment": "development",
                  "identity": {
                    "name": "AI assistant"
                  },
                  "call_reason": "public",
                  "requested_calls": 2,
                  "selected_businesses": 2,
                  "attempted_calls": 1,
                  "answered_calls": 1,
                  "published_results": 1,
                  "discovery_shortfall": 0,
                  "created_at": "2026-11-12T15:00:00Z",
                  "deadline_at": "2026-11-12T15:30:00Z",
                  "finished_at": null,
                  "terminal": false,
                  "cancellation_requested": true,
                  "stop_reason": "canceled",
                  "error": null
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated request identifier for correlating this response.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Thred API key",
        "description": "Send Authorization: Bearer <THRED_API_KEY>. Development keys begin thr_dev_; Production keys begin thr_prod_. Each key is scoped to a workspace and environment. Keep secrets on your server."
      }
    },
    "schemas": {
      "Environment": {
        "type": "string",
        "enum": [
          "development",
          "production"
        ],
        "description": "The API key selects the workspace environment. Development and Production are isolated, but either can place real calls when enabled."
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "thred-data-backend"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "environment": {
            "type": "string",
            "example": "production",
            "description": "API deployment environment. This is not the environment selected by an API key."
          }
        },
        "required": [
          "service",
          "status",
          "environment"
        ]
      },
      "Identity": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "description": "Workspace associated with the API key."
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "key_id": {
            "type": "string",
            "description": "Identifier of the authenticated key; never the key secret."
          }
        },
        "required": [
          "workspace_id",
          "environment",
          "key_id"
        ]
      },
      "DailyUsage": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "requested": {
            "type": "integer",
            "minimum": 0,
            "description": "Accepted child calls, counted once; preparation failures may prevent dialing."
          },
          "completed": {
            "type": "integer",
            "minimum": 0
          },
          "incomplete": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "canceled": {
            "type": "integer",
            "minimum": 0
          },
          "elapsed_job_seconds": {
            "type": "number",
            "minimum": 0,
            "description": "Operational elapsed duration recorded on physical call closure."
          },
          "searches": {
            "type": "integer",
            "minimum": 0,
            "description": "Accepted searches, counted once per idempotency key."
          },
          "attempted_calls": {
            "type": "integer",
            "minimum": 0,
            "description": "Child calls whose dispatch was attempted; provider-uncertain attempts count."
          },
          "answered_calls": {
            "type": "integer",
            "minimum": 0,
            "description": "Child calls answered by the destination, including automated answering systems."
          }
        },
        "required": [
          "day",
          "requested",
          "completed",
          "incomplete",
          "failed",
          "canceled",
          "elapsed_job_seconds",
          "searches",
          "attempted_calls",
          "answered_calls"
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "timezone": {
            "type": "string",
            "enum": [
              "UTC"
            ]
          },
          "attribution": {
            "type": "string",
            "enum": [
              "search_created_date_for_search_metrics_call_created_date_for_call_metrics"
            ]
          },
          "billing_status": {
            "type": "string",
            "enum": [
              "unreconciled"
            ]
          },
          "billed_seconds": {
            "type": "number",
            "nullable": true,
            "enum": [
              null
            ],
            "description": "Always null; these counters are not billing reconciliation."
          },
          "data": {
            "type": "array",
            "minItems": 1,
            "maxItems": 31,
            "items": {
              "$ref": "#/components/schemas/DailyUsage"
            }
          }
        },
        "required": [
          "from",
          "to",
          "environment",
          "timezone",
          "attribution",
          "billing_status",
          "billed_seconds",
          "data"
        ]
      },
      "SearchRequest": {
        "type": "object",
        "required": [
          "query",
          "results"
        ],
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "description": "The information to obtain. Must contain non-whitespace text. Include location when it matters."
          },
          "results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Hard cap of distinct-business call attempts. Unanswered calls and negative answers count; successful matches are not guaranteed."
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "HTTPS website without embedded credentials, to share when relevant.",
                "minLength": 1,
                "maxLength": 2000
              },
              "description": {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1
              }
            },
            "default": {
              "name": "AI assistant"
            }
          },
          "call_reason": {
            "type": "string",
            "enum": [
              "public",
              "customer"
            ],
            "default": "public",
            "description": "Purpose of the call. Public does not make results publicly accessible."
          },
          "location": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "description": "Location to use when discovering relevant businesses."
          },
          "language": {
            "type": "string",
            "example": "en",
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,3}$",
            "description": "Language tag such as en or fr-CA."
          },
          "timezone": {
            "type": "string",
            "default": "UTC",
            "example": "America/Toronto",
            "description": "IANA timezone used to resolve relative dates against this search creation timestamp.",
            "minLength": 1,
            "maxLength": 100
          },
          "output": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 20,
            "additionalProperties": {
              "type": "object",
              "required": [
                "type",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "string[]",
                    "number",
                    "integer",
                    "boolean"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            },
            "description": "Optional custom fields to collect, at most 20 fields and 12,000 characters of JSON. If omitted, each result contains a concise natural-language answer in content and no output property; Thred does not generate custom fields. Field names must contain 1\u2013120 characters and cannot be __proto__, prototype, or constructor. Descriptions must contain non-whitespace text."
          },
          "webhook_id": {
            "type": "string",
            "description": "An enabled webhook endpoint in the same workspace/environment.",
            "minLength": 1,
            "maxLength": 200
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Caller metadata, up to 4000 bytes."
          }
        }
      },
      "Search": {
        "type": "object",
        "required": [
          "id",
          "query",
          "status",
          "environment",
          "identity",
          "call_reason",
          "requested_calls",
          "selected_businesses",
          "attempted_calls",
          "answered_calls",
          "published_results",
          "discovery_shortfall",
          "created_at",
          "deadline_at",
          "finished_at",
          "terminal",
          "cancellation_requested",
          "stop_reason",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "discovering",
              "running",
              "canceling",
              "completed",
              "failed",
              "canceled",
              "expired"
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "development",
              "production"
            ]
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "HTTPS website without embedded credentials, to share when relevant.",
                "minLength": 1,
                "maxLength": 2000
              },
              "description": {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1
              }
            },
            "default": {
              "name": "AI assistant"
            }
          },
          "call_reason": {
            "type": "string",
            "enum": [
              "public",
              "customer"
            ]
          },
          "requested_calls": {
            "type": "integer",
            "minimum": 0
          },
          "selected_businesses": {
            "type": "integer",
            "minimum": 0
          },
          "attempted_calls": {
            "type": "integer",
            "minimum": 0
          },
          "answered_calls": {
            "type": "integer",
            "minimum": 0,
            "description": "Calls answered by the destination, including automated answering systems."
          },
          "published_results": {
            "type": "integer",
            "minimum": 0
          },
          "discovery_shortfall": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "deadline_at": {
            "type": "string",
            "format": "date-time",
            "description": "New dialing stops after 30 minutes. Active calls are canceled; post-call processing may finish later."
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "terminal": {
            "type": "boolean"
          },
          "cancellation_requested": {
            "type": "boolean"
          },
          "stop_reason": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "object",
            "nullable": true,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "description": "Original relevance rank; pagination follows publication order."
          },
          "business": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url",
              "phone",
              "address"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "incomplete",
              "failed",
              "canceled"
            ]
          },
          "call_id": {
            "type": "string",
            "nullable": true
          },
          "content": {
            "type": "string",
            "nullable": true,
            "description": "Concise natural-language answer to the query using facts confirmed on this call. Null when no supported answer is available."
          },
          "output": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Custom structured values conforming to the explicitly supplied request.output fields, or null when unavailable. This property is omitted when request.output is absent."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "call"
                  ]
                },
                "call_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "at_seconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "type",
                "call_id",
                "quote",
                "at_seconds"
              ]
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "phoneExcerpt": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "title",
                "phoneExcerpt"
              ]
            }
          },
          "verified_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the business identity and phone number were verified during discovery; this is not the time the answer was obtained."
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the call result was finalized, or when the outcome was published if no finalized call exists."
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "outcome": {
            "type": "string",
            "nullable": true,
            "description": "Underlying call termination reason, when available (for example an unanswered or canceled call)."
          }
        },
        "description": "A published business outcome. content is the concise natural-language answer, or null when no supported answer is available. output is included only when the search request explicitly supplies a custom output schema.",
        "required": [
          "id",
          "rank",
          "business",
          "status",
          "call_id",
          "content",
          "evidence",
          "sources",
          "verified_at",
          "completed_at",
          "error",
          "outcome"
        ]
      },
      "SearchResultsPage": {
        "type": "object",
        "required": [
          "id",
          "status",
          "results",
          "next_cursor",
          "has_more",
          "terminal"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "discovering",
              "running",
              "canceling",
              "completed",
              "failed",
              "canceled",
              "expired"
            ]
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          },
          "next_cursor": {
            "type": "string",
            "description": "Use for the next page or poll this cursor for future results. Returned even on an empty page."
          },
          "has_more": {
            "type": "boolean",
            "description": "More saved results exist now. False does not imply the search has finished."
          },
          "terminal": {
            "type": "boolean",
            "description": "No future results will be published for this search."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid query, search options, output schema, cursor, webhook, or date range. Inspect error.code and error.message.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, malformed, invalid, revoked, or environment-mismatched bearer API key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "No matching search in this key\u2019s workspace and environment, or the endpoint does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "This idempotency key already belongs to a different normalized request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooLarge": {
        "description": "The request body exceeds 64 KiB. Shorten the query, output descriptions, identity details, or metadata.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "The environment has too many unfinished searches. Child calls wait for existing call concurrency and rate limits.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Calling or the backend is unavailable. Codes include calling_unavailable, environment_unavailable, not_configured, and backend_unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RecordingUnavailable": {
        "description": "Recording is not ready or storage identity cannot be verified. Recording is currently disabled on the hosted API.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
